                                            DirectionalPadUp = "DPAD UP", DirectionalPadDown = "DPAD DOWN",
                                            DirectionalPadLeft = "DPAD LEFT", DirectionalPadRight = "DPAD RIGHT",
                                        }
                                        if map[name] then return map[name] end
                                        if #name > 6 then name = name:sub(1, 6) end
                                        return name:upper()
