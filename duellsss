                                                        wearAccessory(character, humanoid, obj)
                                                    elseif obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") or obj:IsA("BodyColors") then
                                                        wearClothing(character, obj)
                                                    elseif obj:IsA("Model") or obj:IsA("Folder") then
                                                        for _, d in ipairs(obj:GetDescendants()) do
                                                            if d:IsA("Accessory") then
                                                                wearAccessory(character, humanoid, d)
                                                            elseif d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("BodyColors") then
                                                                wearClothing(character, d)
                                                            end
                                                        end
                                                        -- also direct children
                                                        for _, d in ipairs(obj:GetChildren()) do
                                                            if d:IsA("Accessory") then
                                                                wearAccessory(character, humanoid, d)
                                                            elseif d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
                                                                wearClothing(character, d)
                                                            end
                                                        end
                                                    end
                                                end
                                                pcall(function()
                                                    if container and container.Destroy then
                                                        container:Destroy()
                                                    end
                                                end)
                                            else
                                                -- last resort: description only
