_G._BlyraTwoColumnLayout = function(pages)
    local COL_W, GAP, PAD = 332, 10, 8
    local MAX_W = COL_W - 4

    local function setup(page)
        if not page or not page:IsA("ScrollingFrame") or page:GetAttribute("BlyraTwoCol") then
            return
        end
        page:SetAttribute("BlyraTwoCol", true)

        local ll = page:FindFirstChildOfClass("UIListLayout")
        if ll then ll:Destroy() end
        page.AutomaticCanvasSize = Enum.AutomaticSize.None
        page.ScrollingDirection = Enum.ScrollingDirection.Y

        local seen, colOf, hooked = {}, {}, {}
        local counter, firstDone, scheduled = 0, false, false
        local layout

        local function heightOf(o)
            if o.AutomaticSize ~= Enum.AutomaticSize.None and o.AutomaticSize ~= Enum.AutomaticSize.X then
                return o.AbsoluteSize.Y
            end
            return o.Size.Y.Offset
        end

        local function schedule()
            if scheduled then return end
            scheduled = true
            task.defer(function()
                scheduled = false
                pcall(layout)
            end)
        end

        local function hook(o)
            if hooked[o] then return end
            hooked[o] = true
            o:GetPropertyChangedSignal("Size"):Connect(schedule)
            o:GetPropertyChangedSignal("Visible"):Connect(schedule)
            o:GetPropertyChangedSignal("LayoutOrder"):Connect(schedule)
            if o.AutomaticSize ~= Enum.AutomaticSize.None then
                o:GetPropertyChangedSignal("AbsoluteSize"):Connect(schedule)
            end
            if not o:FindFirstChild("BlyraColWidth") then
                local c = Instance.new("UISizeConstraint")
                c.Name = "BlyraColWidth"
                c.MaxSize = Vector2.new(MAX_W, math.huge)
                c.Parent = o
            end
        end

        layout = function()
            local items = {}
            for _, c in ipairs(page:GetChildren()) do
                if c:IsA("GuiObject") then
                    if not seen[c] then
                        counter += 1
                        seen[c] = counter
                    end
                    hook(c)
                    items[#items + 1] = c
                end
            end
            table.sort(items, function(a, b)
                if a.LayoutOrder ~= b.LayoutOrder then return a.LayoutOrder < b.LayoutOrder end
                return seen[a] < seen[b]
            end)

            if not firstDone then
                firstDone = true
                local total = 0
                for _, o in ipairs(items) do
                    if o.Visible then total += heightOf(o) end
                end
                local acc, col = 0, 1
                for _, o in ipairs(items) do
                    if o.Visible then
                        local h = heightOf(o)
                        if col == 1 and acc + h * 0.5 > total / 2 then col = 2 end
                        acc += h
                    end
                    colOf[o] = col
                end
                -- don't leave a section header orphaned at the bottom of column 1
                local lastIdx
                for i, o in ipairs(items) do
                    if colOf[o] == 1 and o.Visible then lastIdx = i end
                end
                if lastIdx and items[lastIdx].Name:sub(1, 8) == "Section_" and lastIdx < #items then
                    colOf[items[lastIdx]] = 2
                end
            end

            local y = { 0, 0 }
            for _, o in ipairs(items) do
                if colOf[o] and o.Visible then
                    y[colOf[o]] += heightOf(o)
                end
            end
            for _, o in ipairs(items) do
                if not colOf[o] then
                    local col = (y[1] <= y[2]) and 1 or 2
                    colOf[o] = col
                    if o.Visible then y[col] += heightOf(o) end
                end
            end

            y = { 0, 0 }
            for _, o in ipairs(items) do
                local col = colOf[o]
                if o.Visible then
                    o.AnchorPoint = Vector2.new(0, 0)
                    o.Position = UDim2.fromOffset((col - 1) * (COL_W + GAP) + 2, y[col])
                    y[col] += heightOf(o)
                end
            end
            page.CanvasSize = UDim2.new(0, 0, 0, math.max(y[1], y[2]) + PAD)
        end

        page.ChildAdded:Connect(schedule)
        page.ChildRemoved:Connect(schedule)
        pcall(layout)
        task.delay(0.3, function() pcall(layout) end)
    end

    for _, page in pairs(pages or {}) do
        pcall(setup, page)
    end
end
